APP_NAME=GauthierFitness
APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
FRONT_URL=http://localhost:5173
FILESYSTEM_DISK=public
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gauthier_fitness
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# Utilisé uniquement par docker-compose.yml (conteneur MySQL local)
DB_ROOT_PASSWORD=your_db_root_password

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="Gauthier Fitness"
MAIL_FROM_ADDRESS=charles.gauthier99@gmail.com
MAIL_SUPPORT_ADDRESS=gauthierfitness.help@gmail.com

SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=

# Origines autorisées en CORS (liste séparée par des virgules).
# Vide en dev = fallback sur localhost:5173/127.0.0.1:5173 (voir config/cors.php).
# En prod : CORS_ALLOWED_ORIGINS=https://gauthierfitness.fr,https://www.gauthierfitness.fr
CORS_ALLOWED_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

STRIPE_SECRET=sk_test_****
STRIPE_WEBHOOK_SECRET=whsec_****
STRIPE_PUBLIC_KEY=pk_test_****

# Sentry — monitoring des exceptions (https://sentry.io)
# DSN du projet Laravel ; laisser vide désactive l'envoi (utile en local/CI)
SENTRY_LARAVEL_DSN=
# Taux d'échantillonnage des traces de performance (0.0 → 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.2
# Environnement remonté à Sentry (par défaut : APP_ENV)
SENTRY_ENVIRONMENT="${APP_ENV}"
